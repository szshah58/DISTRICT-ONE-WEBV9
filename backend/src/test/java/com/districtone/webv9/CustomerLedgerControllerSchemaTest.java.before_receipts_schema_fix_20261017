package com.districtone.webv9;

import com.districtone.webv9.controller.CustomerLedgerController;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.datasource.DriverManagerDataSource;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;

import java.math.BigDecimal;
import java.util.List;
import java.util.Map;

import static org.assertj.core.api.Assertions.assertThat;

/** Executes the customer summary SQL against the live schema's actual column names. */
class CustomerLedgerControllerSchemaTest {
  private JdbcTemplate jdbc;
  private CustomerLedgerController controller;

  @BeforeEach
  void createSchemaAndFixture() {
    var ds = new DriverManagerDataSource(
        "jdbc:h2:mem:customer-ledger-schema;MODE=MySQL;DB_CLOSE_DELAY=-1", "sa", "");
    jdbc = new JdbcTemplate(ds);
    controller = new CustomerLedgerController(jdbc);
    jdbc.execute("DROP ALL OBJECTS");
    jdbc.execute("CREATE TABLE webv9_customer_accounts (account_id BIGINT PRIMARY KEY, member_id BIGINT, is_active BOOLEAN, registration_status VARCHAR(20))");
    jdbc.execute("CREATE TABLE registrations (registration_id BIGINT PRIMARY KEY, member_id BIGINT, reg_no VARCHAR(30), form_no VARCHAR(100), category VARCHAR(100))");
    jdbc.execute("CREATE TABLE sales_bookings (sale_booking_id BIGINT PRIMARY KEY, registration_id BIGINT, plot_id BIGINT, sale_status VARCHAR(50))");
    jdbc.execute("CREATE TABLE plots (plot_id BIGINT PRIMARY KEY, block_id BIGINT, plot_no VARCHAR(50), plot_size_marla DECIMAL(6,2), plot_type VARCHAR(50), category VARCHAR(100))");
    jdbc.execute("CREATE TABLE blocks (block_id BIGINT PRIMARY KEY, block_code VARCHAR(50), block_name VARCHAR(100))");
    jdbc.execute("CREATE TABLE webv9_receivables (id BIGINT PRIMARY KEY, member_id BIGINT, registration_id BIGINT, booking_id BIGINT, plot_id BIGINT, original_amount DECIMAL(16,2), paid_amount DECIMAL(16,2), surcharge_amount DECIMAL(16,2), adjustment_amount DECIMAL(16,2), status VARCHAR(30), description VARCHAR(500))");
    jdbc.execute("CREATE TABLE webv9_customer_ledger (id BIGINT PRIMARY KEY, member_id BIGINT, booking_id BIGINT, payment_id BIGINT, debit DECIMAL(16,2), credit DECIMAL(16,2))");
    jdbc.update("INSERT INTO webv9_customer_accounts VALUES (1, 10, TRUE, 'ACTIVE')");
    jdbc.update("INSERT INTO registrations VALUES (20, 10, 'R-20', 'F-20', 'RESIDENTIAL'), (21, 10, 'R-21', 'F-21', 'RESIDENTIAL'), (22, 11, 'R-22', 'F-22', 'RESIDENTIAL')");
    jdbc.update("INSERT INTO sales_bookings VALUES (30, 20, 40, 'ALLOCATED'), (31, 21, 41, 'ALLOCATED'), (32, 22, 42, 'ALLOCATED')");
    jdbc.update("INSERT INTO plots VALUES (40, 50, 'P-40', 5, 'RESIDENTIAL', 'RESIDENTIAL'), (41, 50, 'P-41', 5, 'RESIDENTIAL', 'RESIDENTIAL'), (42, 50, 'P-42', 5, 'RESIDENTIAL', 'RESIDENTIAL')");
    jdbc.update("INSERT INTO blocks VALUES (50, 'A', 'Block A')");
    // Development charges and a second assessed charge for property 20.
    jdbc.update("INSERT INTO webv9_receivables VALUES (80, 10, 20, 30, 40, 1000, 125, 50, 10, 'PARTIAL', 'Development Charges'), (81, 10, 20, 30, 40, 200, 25, 0, 0, 'PARTIAL', 'Other assessed charge'), (82, 10, 21, 31, 41, 999, 0, 0, 0, 'DUE', 'Different property charge'), (83, 11, 22, 32, 42, 5000, 0, 0, 0, 'DUE', 'Another customer charge')");
    // Legacy ledger transactions intentionally differ from the receivable balances.
    jdbc.update("INSERT INTO webv9_customer_ledger VALUES (60, 10, 30, 70, 100, 0), (61, 10, 30, 71, 0, 25)");
  }

  @Test
  void includesDevelopmentChargesSurchargeAdjustmentsAndPostedPayments() {
    var response = controller.getPropertyLedger(20L,
        UsernamePasswordAuthenticationToken.authenticated("customer:1", "", List.of()));

    assertThat(response.getStatusCode().value()).isEqualTo(200);
    @SuppressWarnings("unchecked")
    Map<String, Object> body = (Map<String, Object>) response.getBody();
    assertThat(body).containsEntry("totalDue", new BigDecimal("1240.00"))
        .containsEntry("totalPaid", new BigDecimal("150.00"))
        .containsEntry("outstanding", new BigDecimal("1090.00"));
    @SuppressWarnings("unchecked")
    List<Map<String, Object>> rows = (List<Map<String, Object>>) body.get("ledger");
    assertThat(rows).hasSize(2);
    assertThat(((Number) rows.get(0).get("runningBalance")).intValue()).isEqualTo(100);
    assertThat(((Number) rows.get(1).get("runningBalance")).intValue()).isEqualTo(75);
  }

  @Test
  void summaryDoesNotMixAnotherSelectedProperty() {
    var response = controller.getPropertyLedger(21L,
        UsernamePasswordAuthenticationToken.authenticated("customer:1", "", List.of()));

    @SuppressWarnings("unchecked")
    Map<String, Object> body = (Map<String, Object>) response.getBody();
    assertThat(body).containsEntry("totalDue", new BigDecimal("999.00"))
        .containsEntry("totalPaid", new BigDecimal("0.00"))
        .containsEntry("outstanding", new BigDecimal("999.00"));
  }

  @Test
  void retainsCustomerPropertyOwnershipCheck() {
    var response = controller.getPropertyLedger(22L,
        UsernamePasswordAuthenticationToken.authenticated("customer:1", "", List.of()));
    assertThat(response.getStatusCode().value()).isEqualTo(404);
  }
}